<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elite_bg"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- HEADER - EASY -->
        <TextView android:id="@+id/tvAppName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Elite Loader" android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/elite_neon" android:letterSpacing="0.12"
            android:layout_marginTop="24dp" />

        <TextView android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Powered by Elite SDK" android:textSize="12sp"
            android:textColor="@color/elite_text2" android:layout_marginTop="4dp"
            android:letterSpacing="0.08" />

        <View android:layout_width="40dp" android:layout_height="2dp"
            android:background="@color/elite_neon" android:layout_marginTop="12dp"
            android:alpha="0.8" />

        <!-- STATUS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/elite_card" app:strokeColor="@color/elite_border"
            app:strokeWidth="1dp" app:cardElevation="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="● STATUS" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="@color/elite_neon" android:letterSpacing="0.14" />

                <TextView android:id="@+id/tvStatus"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Ready • Tap Install" android:textSize="12sp"
                    android:textColor="@color/elite_text2" android:lineSpacingExtra="4dp"
                    android:layout_marginTop="10dp" android:background="@color/elite_surface"
                    android:padding="12dp" />

                <TextView android:id="@+id/tvPanelLink"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="https://manishflash.online/api/connect.php" android:textSize="9sp"
                    android:textColor="@color/elite_text2" android:alpha="0.7"
                    android:layout_marginTop="8dp" android:letterSpacing="0.02" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ACTION GRID - EASY -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstall"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="56dp" android:layout_marginEnd="8dp"
                android:text="@string/install" android:textStyle="bold"
                app:cornerRadius="12dp" app:icon="@android:drawable/stat_sys_download" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaunch"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="56dp" android:layout_marginStart="8dp"
                android:text="@string/launch" android:textStyle="bold"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp" app:strokeColor="@color/elite_neon"
                android:textColor="@color/elite_neon" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUninstall"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:layout_marginEnd="8dp"
                android:text="@string/uninstall" android:textSize="11sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp" app:strokeColor="@color/elite_border"
                android:textColor="@color/elite_text2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckPanel"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:layout_marginStart="8dp"
                android:text="@string/check_panel" android:textSize="11sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp" app:strokeColor="@color/elite_border"
                android:textColor="@color/elite_text2" />
        </LinearLayout>

        <!-- EASY GUIDE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/elite_surface" app:strokeColor="@color/elite_border"
            app:strokeWidth="1dp" app:cardElevation="0dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✏️ EASY CUSTOMIZE" android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/elite_neon2" android:letterSpacing="0.1" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1. AppConfig.kt me APP_NAME badlo\n2. strings.xml me app_name badlo\n3. build.gradle me appPackage badlo\n4. colors.xml me theme color badlo"
                    android:textSize="11sp" android:textColor="@color/elite_text2"
                    android:lineSpacingExtra="6dp" android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeName"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:layout_marginTop="10dp" android:text="Where to change name?"
                    android:textSize="10sp" style="@style/Widget.Material3.Button.TextButton"
                    android:textColor="@color/elite_neon" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Elite Loader Easy • v1.0 • Single AAR" android:textSize="9sp"
            android:textColor="@color/elite_text2" android:alpha="0.5"
            android:layout_marginTop="20dp" android:letterSpacing="0.06" />

    </LinearLayout>
</ScrollView>
